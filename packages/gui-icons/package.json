{
  "name": "@nvidia/gui-icons",
  "version": "1.0.0",
  "license": "CC-BY-4.0 AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NVIDIA/icons.git",
    "directory": "packages/gui-icons"
  },
  "homepage": "https://github.com/NVIDIA/icons/tree/main/packages/gui-icons#readme",
  "bugs": {
    "url": "https://github.com/NVIDIA/icons/issues"
  },
  "author": "NVIDIA Corporation",
  "engines": {
    "node": ">=22"
  },
  "description": "NVIDIA GUI Icons: raw SVG assets and TypeScript constants (line and fill variants).",
  "keywords": [
    "nvidia",
    "icons",
    "svg",
    "ui",
    "gui-icons"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./iconTypes": {
      "types": "./dist/iconTypes.d.ts",
      "import": "./dist/iconTypes.mjs",
      "require": "./dist/iconTypes.cjs"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/",
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
