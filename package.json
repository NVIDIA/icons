{
  "name": "icons",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "NVIDIA Icons: public npm packages (@nvidia scope)",
  "repository": {
    "type": "git",
    "url": "https://github.com/NVIDIA/icons.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:react-compat": "node ./scripts/react-compat-smoke.mjs",
    "generate-notices": "node ./scripts/generate-third-party-notices.mjs",
    "verify:packaging": "node ./scripts/verify-packaging.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.5.1",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "packageManager": "npm@11.19.0"
}
