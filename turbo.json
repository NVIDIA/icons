{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["REACT_COMPAT_VERSIONS", "GITHUB_STEP_SUMMARY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
